generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Admin
  Manager
  Staff
}

model Users {
  userId    String   @id
  image     String?
  name      String
  email     String   @unique
  role      UserRole @default(Staff)
  createdAt DateTime @default(now())

  @@index([role])
}

model Categories {
  categoryId  String     @id
  name        String     @unique
  description String?
  color       String     @default("#3b82f6")
  createdAt   DateTime   @default(now())
  Products    Products[]

  @@index([name])
}

model Suppliers {
  supplierId String      @id
  name       String
  email      String?
  phone      String?
  address    String?
  createdAt  DateTime    @default(now())
  Purchases  Purchases[]

  @@index([name])
}

model Products {
  productId     String      @id
  image         String?
  name          String
  price         Float
  rating        Float?
  stockQuantity Int
  categoryId    String?
  category      Categories? @relation(fields: [categoryId], references: [categoryId])
  Sales         Sales[]
  Purchases     Purchases[]

  @@index([name])
  @@index([stockQuantity])
  @@index([categoryId])
}

model Sales {
  saleId      String   @id
  productId   String
  timestamp   DateTime
  quantity    Int
  unitPrice   Float
  totalAmount Float
  product     Products @relation(fields: [productId], references: [productId])

  @@index([productId])
  @@index([timestamp])
}

model Purchases {
  purchaseId String     @id
  productId  String
  supplierId String?
  timestamp  DateTime
  quantity   Int
  unitCost   Float
  totalCost  Float
  product    Products  @relation(fields: [productId], references: [productId])
  supplier   Suppliers? @relation(fields: [supplierId], references: [supplierId])

  @@index([productId])
  @@index([supplierId])
  @@index([timestamp])
}

model Expenses {
  expenseId String   @id
  category  String
  amount    Float
  timestamp DateTime

  @@index([category])
  @@index([timestamp])
}

model SalesSummary {
  salesSummaryId   String   @id
  totalValue       Float
  changePercentage Float?
  date             DateTime

  @@index([date])
}

model PurchaseSummary {
  purchaseSummaryId String   @id
  totalPurchased    Float
  changePercentage  Float?
  date              DateTime

  @@index([date])
}

model ExpenseSummary {
  expenseSummaryId  String              @id
  totalExpenses     Float
  date              DateTime
  ExpenseByCategory ExpenseByCategory[]

  @@index([date])
}

model ExpenseByCategory {
  expenseByCategoryId String         @id
  expenseSummaryId    String
  category            String
  amount              BigInt
  date                DateTime
  expenseSummary      ExpenseSummary @relation(fields: [expenseSummaryId], references: [expenseSummaryId])

  @@index([expenseSummaryId])
  @@index([category])
  @@index([date])
}
