generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Admin
  Manager
  Staff
}

model Users {
  userId    String   @id
  image     String?
  name      String
  email     String   @unique
  username  String?  @unique
  password  String?
  role      UserRole @default(Staff)
  createdAt DateTime @default(now())

  @@index([role])
}

model Categories {
  categoryId  String     @id
  name        String     @unique
  description String?
  color       String     @default("#3b82f6")
  createdAt   DateTime   @default(now())
  Products    Products[]

  @@index([name])
}

model Suppliers {
  supplierId     String           @id
  name           String
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime         @default(now())
  Purchases      Purchases[]
  PurchaseOrders PurchaseOrders[]

  @@index([name])
}

model Products {
  productId     String      @id
  image         String?
  name          String
  price         Float
  rating        Float?
  stockQuantity Int
  categoryId    String?
  category      Categories? @relation(fields: [categoryId], references: [categoryId])
  Sales               Sales[]
  Purchases           Purchases[]
  PurchaseOrderItems  PurchaseOrderItems[]

  @@index([name])
  @@index([stockQuantity])
  @@index([categoryId])
}

model Sales {
  saleId      String   @id
  productId   String
  timestamp   DateTime
  quantity    Int
  unitPrice   Float
  totalAmount Float
  product     Products @relation(fields: [productId], references: [productId])

  @@index([productId])
  @@index([timestamp])
}

model Purchases {
  purchaseId String     @id
  productId  String
  supplierId String?
  timestamp  DateTime
  quantity   Int
  unitCost   Float
  totalCost  Float
  product    Products  @relation(fields: [productId], references: [productId])
  supplier   Suppliers? @relation(fields: [supplierId], references: [supplierId])

  @@index([productId])
  @@index([supplierId])
  @@index([timestamp])
}

model Expenses {
  expenseId String   @id
  category  String
  amount    Float
  timestamp DateTime

  @@index([category])
  @@index([timestamp])
}

model SalesSummary {
  salesSummaryId   String   @id
  totalValue       Float
  changePercentage Float?
  date             DateTime

  @@index([date])
}

model PurchaseSummary {
  purchaseSummaryId String   @id
  totalPurchased    Float
  changePercentage  Float?
  date              DateTime

  @@index([date])
}

model ExpenseSummary {
  expenseSummaryId  String              @id
  totalExpenses     Float
  date              DateTime
  ExpenseByCategory ExpenseByCategory[]

  @@index([date])
}

model ExpenseByCategory {
  expenseByCategoryId String         @id
  expenseSummaryId    String
  category            String
  amount              BigInt
  date                DateTime
  expenseSummary      ExpenseSummary @relation(fields: [expenseSummaryId], references: [expenseSummaryId])

  @@index([expenseSummaryId])
  @@index([category])
  @@index([date])
}

enum OrderStatus {
  Draft
  Ordered
  Received
  Cancelled
}

model PurchaseOrders {
  orderId    String               @id
  supplierId String?
  status     OrderStatus          @default(Draft)
  notes      String?
  totalCost  Float                @default(0)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  supplier   Suppliers?           @relation(fields: [supplierId], references: [supplierId])
  items      PurchaseOrderItems[]

  @@index([status])
  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseOrderItems {
  itemId    String         @id
  orderId   String
  productId String
  quantity  Int
  unitCost  Float
  order     PurchaseOrders @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product   Products       @relation(fields: [productId], references: [productId])

  @@index([orderId])
  @@index([productId])
}
